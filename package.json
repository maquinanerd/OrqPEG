{
  "name": "orqpeg",
  "version": "1.0.0",
  "description": "Orquestrador local que coordena Claude Code e Codex CLI para executar, revisar, testar e integrar trabalhos em múltiplos repositórios Git.",
  "license": "MIT",
  "private": true,
  "author": "maquinanerd",
  "repository": {
    "type": "git",
    "url": "https://github.com/maquinanerd/OrqPEG.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "orqpeg": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:security": "node scripts/run-tests.js security",
    "test:e2e": "node scripts/run-tests.js e2e",
    "check": "node dist/cli/main.js doctor --json",
    "start": "node dist/cli/main.js",
    "panel": "node dist/cli/main.js panel start"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "5.6.3"
  },
  "dependencies": {}
}
